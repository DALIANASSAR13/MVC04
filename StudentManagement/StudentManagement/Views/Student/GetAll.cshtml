@model List<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "All Students";
}

<h1>All Students</h1>

<form method="get" asp-action="GetAll" class="mb-3">
    <div class="mb-2">
        <label for="searchName">Search by name</label>
        <input id="searchName" name="searchName"
               value="@ViewBag.SearchName"
               class="form-control"
               placeholder="Enter student name" />
    </div>

    <div class="mb-2">
        <label for="departmentId">Filter by department</label>
        <select id="departmentId" name="departmentId"
                class="form-select"
                asp-items="ViewBag.Departments">
            <option value="">All Departments</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Search / Filter</button>
    <a asp-action="GetAll" class="btn btn-secondary">Reset</a>
</form>

<p>
    <a asp-action="Add" class="btn btn-success">Add Student</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
                <td>@student.Department?.Name</td>
                <td>
                    <a asp-action="GetById"
                       asp-route-id="@student.Id">Details</a> |
                    <a asp-action="Edit"
                       asp-route-id="@student.Id">Edit</a> |
                    <a asp-action="Delete"
                       asp-route-id="@student.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p>No students found.</p>
}

<div class="mt-3">
    @if ((int)ViewBag.CurrentPage > 1)
    {
        <a class="btn btn-outline-primary"
           asp-action="GetAll"
           asp-route-pageNumber="@((int)ViewBag.CurrentPage - 1)"
           asp-route-searchName="@ViewBag.SearchName"
           asp-route-departmentId="@ViewBag.SelectedDepartmentId">
            Previous
        </a>
    }

    <span class="mx-2">
        Page @ViewBag.CurrentPage of @ViewBag.TotalPages
    </span>

    @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
    {
        <a class="btn btn-outline-primary"
           asp-action="GetAll"
           asp-route-pageNumber="@((int)ViewBag.CurrentPage + 1)"
           asp-route-searchName="@ViewBag.SearchName"
           asp-route-departmentId="@ViewBag.SelectedDepartmentId">
            Next
        </a>
    }
</div>
